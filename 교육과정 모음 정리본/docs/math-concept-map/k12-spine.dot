    "spine_subj_gongsu1" [label="공통수학1", shape=ellipse];
    "spine_subj_gongsu2" [label="공통수학2", shape=ellipse];
    "spine_subj_gisu1" [label="기본수학1", shape=ellipse];
    "spine_subj_gisu2" [label="기본수학2", shape=ellipse];
  }
