    "spine_subj_gyeongsu" [label="경제 수학 (진로 선택 과목)", shape=ellipse];
    "spine_subj_insu" [label="인공지능 수학 (진로 선택 과목)", shape=ellipse];
    "spine_subj_jiksu" [label="직무 수학 (진로 선택 과목)", shape=ellipse];
