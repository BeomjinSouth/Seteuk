    "spine_dom_e12_04" [label="초1-2 자료와 가능성", shape=box];
    "spine_stage_e34" [label="초등학교 3~4학년 수학", shape=ellipse];
    "spine_dom_e34_01" [label="초3-4 수와 연산", shape=box];
    "spine_dom_e34_02" [label="초3-4 변화와 관계", shape=box];
    "spine_dom_e34_03" [label="초3-4 도형과 측정", shape=box];
    "spine_dom_e34_04" [label="초3-4 자료와 가능성", shape=box];
    "spine_stage_e56" [label="초등학교 5~6학년 수학", shape=ellipse];
    "spine_dom_e56_01" [label="초5-6 수와 연산", shape=box];
    "spine_dom_e56_02" [label="초5-6 변화와 관계", shape=box];
    "spine_dom_e56_03" [label="초5-6 도형과 측정", shape=box];
    "spine_dom_e56_04" [label="초5-6 자료와 가능성", shape=box];
  }
  subgraph cluster_middle {
    label="중학교";
    "spine_stage_m13" [label="중학교 1~3학년 수학", shape=ellipse];
    "spine_dom_m13_01" [label="중1-3 수와 연산", shape=box];
    "spine_dom_m13_02" [label="중1-3 변화와 관계", shape=box];
